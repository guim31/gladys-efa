  "name": "EFA (VRR, VVS, KVV…)",
  "description": {
    "en": "Real-time departures of German and Austrian networks (VRR, VVS, KVV, MVV…): delays, disruptions.",
    "fr": "Prochains départs en temps réel des réseaux allemands et autrichiens (VRR, VVS, KVV, MVV…).",
    "de": "Nächste Echtzeit-Abfahrten deutscher und österreichischer Verbünde (VRR, VVS, KVV, MVV…).",
    "es": "Próximas salidas en tiempo real de las redes alemanas y austriacas (VRR, VVS, KVV, MVV…)."
  },
  "version": "1.0.0",
  "docker_image": "ghcr.io/guim31/gladys-efa:1.0.0",
  "gladys_version": ">=5.3.0",
